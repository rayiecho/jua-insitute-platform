NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by trusted Route Handlers that write past RLS (e.g. /api/learner)
SUPABASE_SERVICE_ROLE_KEY=

# Only needed if the web app calls LiveKit directly to mint room tokens
# (otherwise this lives server-side in the agent worker / a dedicated API route)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
