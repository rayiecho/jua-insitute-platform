# Absolute URL to the Next.js web app (apps/web) — a phone can't use relative
# fetch('/api/...') paths like the web app can, so this has to be a real
# reachable address. When testing on a physical device, this MUST be your
# dev machine's LAN IP (not localhost/127.0.0.1), and the phone must be on
# the same network as the machine running `npm run dev` in apps/web.
#
# Find your machine's LAN IP: `ipconfig` (Windows) — look for the IPv4
# address on the Wi-Fi adapter you're actually connected through.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000
